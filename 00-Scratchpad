

Step 01 — Delete old Simple Scaling policies

aws autoscaling delete-policy ^
  --auto-scaling-group-name WNXT-INT-USER-ASG ^
  --policy-name WNXT-INT-USER-ScaleOut ^
  --region us-east-1

aws autoscaling delete-policy ^
  --auto-scaling-group-name WNXT-INT-USER-ASG ^
  --policy-name WNXT-INT-USER-ScaleIn ^
  --region us-east-1


Step 2 — Create Step Scaling Scale IN / Out policies

Step 3 — Deploy both policies

aws autoscaling put-scaling-policy ^
  --cli-input-json file://step-scaleout-policy.json ^
  --region us-east-1

aws autoscaling put-scaling-policy ^
  --cli-input-json file://step-scalein-policy.json ^
  --region us-east-1


Step 3.5 - Get the ARNS from above scalein and scaleout policies

aws autoscaling describe-policies ^
  --auto-scaling-group-name WNXT-INT-USER-ASG ^
  --policy-names WNXT-INT-USER-StepScaleOut WNXT-INT-USER-StepScaleIn ^
  --query "ScalingPolicies[*].{Name:PolicyName,ARN:PolicyARN}" ^
  --region us-east-1

Step 4 — Update WNXT-Sessions-High alarm to trigger Scale Out

aws cloudwatch put-metric-alarm ^
  --cli-input-json file://sessions-high-alarm.json ^
  --region us-east-1


Step 5 - Verify

aws cloudwatch describe-alarms ^
  --alarm-names "WNXT-Sessions-High" ^
  --region us-east-1


