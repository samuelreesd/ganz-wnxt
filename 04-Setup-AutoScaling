🏗️ Architecture Overview
The Java program on each EC2 instance collects local metrics → publishes to CloudWatch under a custom namespace (Ganz/Webkinz) → CloudWatch Alarms trigger Auto Scaling policies.

Step 1: Set Up the Custom CloudWatch Namespace
The namespace Ganz/Webkinz will be automatically created the first time your Java program publishes a metric to it — no manual creation needed. However, you need to ensure the right permissions are in place.

Step 2: IAM Permissions for EC2 Instances
Each EC2 instance needs an IAM Role with permission to publish CloudWatch metrics.
Create an IAM Policy:
json{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "Ganz/Webkinz"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeTags",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
Attach this policy to the EC2 Instance Profile (IAM Role) assigned to your EC2 instances.

Step 3: Java Program — Publish Metrics to CloudWatch
Here's a complete Java example using the AWS SDK v2:
javaimport software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.cloudwatch.CloudWatchClient;
import software.amazon.awssdk.services.cloudwatch.model.*;

import java.time.Instant;

public class WNXTMetricsPublisher {

    public static void main(String[] args) {

        // Collect environment variables with defaults
        String region     = System.getenv("REGION_NAME")    != null ? System.getenv("REGION_NAME")    : "us-east-1";
        String namespace  = System.getenv("NAMESPACE_NAME") != null ? System.getenv("NAMESPACE_NAME") : "Ganz/Webkinz";
        String cluster    = System.getenv("CLUSTER_NAME")   != null ? System.getenv("CLUSTER_NAME")   : "WebkinzCluster";
        String instanceId = System.getenv("INSTANCE_ID")   != null ? System.getenv("INSTANCE_ID")    : "123456789";
        String asg        = System.getenv("ASG_NAME")       != null ? System.getenv("ASG_NAME")       : "WebkinzASG";

        // Build CloudWatch client
        CloudWatchClient cw = CloudWatchClient.builder()
                .region(Region.of(region))
                .build();

        // Define dimensions
        Dimension clusterDimension = Dimension.builder()
                .name("ClusterName").value(cluster).build();

        Dimension instanceDimension = Dimension.builder()
                .name("InstanceId").value(instanceId).build();

        Dimension asgDimension = Dimension.builder()
                .name("AutoScalingGroupName").value(asg).build();

        // Example metric: CPU Utilization (replace with your actual metric value)
        double cpuUtilization = getCpuUtilization(); // your collection logic

        MetricDatum datum = MetricDatum.builder()
                .metricName("CPUUtilization")
                .unit(StandardUnit.PERCENT)
                .value(cpuUtilization)
                .timestamp(Instant.now())
                .dimensions(clusterDimension, instanceDimension, asgDimension)
                .build();

        PutMetricDataRequest request = PutMetricDataRequest.builder()
                .namespace(namespace)
                .metricData(datum)
                .build();

        cw.putMetricData(request);
        System.out.println("Metric published: " + cpuUtilization + "% CPU to namespace: " + namespace);

        cw.close();
    }

    private static double getCpuUtilization() {
        // Replace with actual system metric collection logic
        // e.g., via OperatingSystemMXBean or a monitoring library
        return 65.0;
    }
}
